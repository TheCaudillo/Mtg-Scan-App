# ---------- Scanner service ----------
# Where SQLite, bulk downloads, art index and uploads live (relative to repo root or absolute)
DATA_DIR=./data
# Polite User-Agent for Scryfall (required by their API guidelines)
SCRYFALL_USER_AGENT=BinderScanMTG/0.1 (local dev)

# Matcher mode: auto | clip | phash | vision | none
#   auto   = local visual index if built (CLIP, else pHash) + vision LLM for disambiguation if a key is set
MATCHER_MODE=auto

# Vision LLM disambiguator (Mode B). Leave VISION_PROVIDER empty to disable.
VISION_PROVIDER=            # anthropic | openai | gemini
VISION_MODEL=               # optional override; sensible fast default per provider
VISION_CONCURRENCY=6
VISION_TIMEOUT_S=45
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local visual index (Mode A)
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Detection
DETECTOR=opencv             # opencv | yolo11 (future)

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Web app ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000
